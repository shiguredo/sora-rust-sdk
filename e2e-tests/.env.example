# Sora シグナリング URL (カンマ区切りで複数指定可)
TEST_SIGNALING_URLS=wss://sora1.example.com/signaling,wss://sora2.example.com/signaling

# チャネル ID プリフィックス (省略可)
TEST_CHANNEL_ID_PREFIX=e2e-test-

# チャネル ID サフィックス (省略可)
TEST_CHANNEL_ID_SUFFIX=

# API URL (省略可)
# TEST_API_URL=http://localhost:3000/

# シークレットキー (省略可)
# TEST_SECRET_KEY=your-secret-key
